{
  "name": "@lininn/openflow",
  "version": "0.1.9",
  "description": "OpenSpec + Superpowers workflow orchestrator for Claude Code",
  "bin": {
    "openflow": "./bin/openflow.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "postinstall": "node ./scripts/postinstall.js",
    "test:enforce:unit": "pnpm node scripts/test-enforce-rules.mjs && pnpm node scripts/test-enforce.mjs && pnpm node scripts/test-gate.mjs && pnpm node scripts/test-detect.mjs && pnpm node scripts/test-install.mjs",
    "test:enforce": "pnpm run build && pnpm run test:enforce:unit",
    "test": "pnpm run test:enforce"
  },
  "keywords": [
    "claude-code",
    "openspec",
    "superpowers",
    "workflow",
    "skill"
  ],
  "author": "lininn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lininn/openflow.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "runtime": {
      "name": "node",
      "version": "^20.0.0",
      "onFail": "download"
    }
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "hooks",
    "scripts"
  ],
  "dependencies": {
    "@lininn/openflow": "link:",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "inquirer": "^13.4.3",
    "ora": "^8.0.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
